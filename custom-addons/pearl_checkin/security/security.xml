<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_pearl" model="ir.module.category">
        <field name="name">Pearl Restaurant</field>
        <field name="description">User access level for Pearl Checkin</field>
        <field name="sequence">25</field>
    </record>

    <record id="res_groups_privilege_pearl" model="res.groups.privilege">
        <field name="name">Pearl Restaurant</field>
        <field name="sequence">25</field>
        <field name="category_id" ref="module_category_pearl"/>
    </record>

    <record id="group_pearl_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_pearl"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_pearl_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_pearl"/>
        <field name="implied_ids" eval="[(4, ref('group_pearl_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
