<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Management Dashboard Form View Phase 3 Enhanced -->
    <record id="view_sunnyside_dashboard_form" model="ir.ui.view">
        <field name="name">sunnyside.dashboard.form</field>
        <field name="model">sunnyside.dashboard</field>
        <field name="arch" type="xml">
            <form string="Management Dashboard" create="false" delete="false" class="o_sunnyside_dashboard_form">
                <header>
                    <button name="action_open_checkin_wizard"
                            string="New Check-in"
                            type="object"
                            class="btn-primary"
                            icon="fa-id-card-o"/>
                    <button name="action_view_seating_management"
                            string="Seating Map"
                            type="object"
                            class="btn-secondary"
                            icon="fa-map-marker"/>
                    <button name="action_refresh_metrics"
                            string="Refresh"
                            type="object"
                            class="btn-outline-secondary"
                            icon="fa-refresh"/>
                </header>
                <sheet style="max-width:100%;width:100%;margin:0;padding:1.5rem 2rem;box-sizing:border-box;">

                    <!-- ===================================================== -->
                    <!-- DASHBOARD HEADER                                        -->
                    <!-- ===================================================== -->
                    <div class="mb-4 border-bottom pb-3">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                            <div>
                                <h1 class="text-primary fw-bold mb-1">
                                    <i class="fa fa-sun-o text-warning me-2"></i> Sunnyside Beach Overview
                                </h1>
                                <p class="text-muted small mb-0">
                                    Real-time operational dashboard for visitor activity, seating availability and financial performance.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- ===================================================== -->
                    <!-- DATE RANGE FILTER                                       -->
                    <!-- ===================================================== -->
                    <div class="card border-0 rounded-3 p-3 bg-white shadow-sm mb-4">
                        <div class="d-flex align-items-center flex-wrap gap-3">
                            <span class="fw-semibold text-dark me-2">
                                <i class="fa fa-filter text-primary me-1"></i> Date Range Filter
                            </span>
                            <field name="date_filter"
                                   widget="radio"
                                   options="{'horizontal': true}"
                                   nolabel="1"/>
                            <div class="d-flex align-items-center gap-2 ms-auto" invisible="date_filter != 'custom'">
                                <span class="text-muted small">From</span>
                                <field name="date_from" nolabel="1" class="form-control form-control-sm" style="width:140px"/>
                                <span class="text-muted small">To</span>
                                <field name="date_to" nolabel="1" class="form-control form-control-sm" style="width:140px"/>
                                <button name="action_apply_date_filter" type="object"
                                        class="btn btn-primary btn-sm" string="Apply"/>
                            </div>
                        </div>
                    </div>

                    <!-- ===================================================== -->
                    <!-- SECTION 1: TODAY'S VISITOR ACTIVITY                    -->
                    <!-- ===================================================== -->
                    <div class="mb-2 mt-1">
                        <h5 class="fw-bold text-dark border-bottom pb-2">
                            <i class="text-success me-2"></i> Today's Visitor Activity
                        </h5>
                    </div>
                    <div class="row g-3 mb-4">

                        <!-- Total Registered Visitors -->
                        <div class="col-12 col-sm-6 col-lg-3">
                            <div class="card shadow-sm border-0 rounded-3 p-3 h-100" style="border-left: 4px solid #0ea5e9 !important;">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <span class="text-muted small fw-semibold text-uppercase">Total Visitors</span>
                                        <h2 class="display-6 fw-bold text-dark mt-1 mb-0">
                                            <field name="total_visitors"/>
                                        </h2>
                                        <small class="text-muted">Distinct guest profiles</small>
                                    </div>
                                    <div class="p-2 bg-primary-subtle text-primary rounded-3">
                                        <i class="fa fa-users fs-4"></i>
                                    </div>
                                </div>
                                <div class="mt-3 pt-2 border-top">
                                    <button name="action_view_visitors" type="object" class="btn btn-sm btn-link p-0 text-decoration-none">
                                        <span>View Visitor Directory</span> <i class="fa fa-arrow-right ms-1"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Check-ins Today -->
                        <div class="col-12 col-sm-6 col-lg-3">
                            <div class="card shadow-sm border-0 rounded-3 p-3 h-100" style="border-left: 4px solid #22c55e !important;">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <span class="text-muted small fw-semibold text-uppercase">Check-ins Today</span>
                                        <h2 class="display-6 fw-bold text-success mt-1 mb-0">
                                            <field name="checkins_today"/>
                                        </h2>
                                        <small class="text-muted">Total entries today</small>
                                    </div>
                                    <div class="p-2 bg-success-subtle text-success rounded-3">
                                        <i class="fa fa-sign-in fs-4"></i>
                                    </div>
                                </div>
                                <div class="mt-3 pt-2 border-top">
                                    <button name="action_view_today_checkins" type="object" class="btn btn-sm btn-link p-0 text-decoration-none">
                                        <span>View Today's Check-ins</span> <i class="fa fa-arrow-right ms-1"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- New Guests Today -->
                        <div class="col-12 col-sm-6 col-lg-3">
                            <div class="card shadow-sm border-0 rounded-3 p-3 h-100" style="border-left: 4px solid #3b82f6 !important;">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <span class="text-muted small fw-semibold text-uppercase">New Guests Today</span>
                                        <h2 class="display-6 fw-bold text-primary mt-1 mb-0">
                                            <field name="new_visitors_today"/>
                                        </h2>
                                        <small class="text-muted">First-ever check-ins</small>
                                    </div>
                                    <div class="p-2 bg-info-subtle text-info rounded-3">
                                        <i class="fa fa-user-plus fs-4"></i>
                                    </div>
                                </div>
                                <div class="mt-3 pt-2 border-top">
                                    <button name="action_view_today_new" type="object" class="btn btn-sm btn-link p-0 text-decoration-none">
                                        <span>View New Guests</span> <i class="fa fa-arrow-right ms-1"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Returning Guests Today -->
                        <div class="col-12 col-sm-6 col-lg-3">
                            <div class="card shadow-sm border-0 rounded-3 p-3 h-100" style="border-left: 4px solid #f59e0b !important;">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <span class="text-muted small fw-semibold text-uppercase">Returning Today</span>
                                        <h2 class="display-6 fw-bold text-warning mt-1 mb-0">
                                            <field name="returning_visitors_today"/>
                                        </h2>
                                        <small class="text-muted">Repeat guests welcomed back</small>
                                    </div>
                                    <div class="p-2 bg-warning-subtle text-warning rounded-3">
                                        <i class="fa fa-repeat fs-4"></i>
                                    </div>
                                </div>
                                <div class="mt-3 pt-2 border-top">
                                    <button name="action_view_today_returning" type="object" class="btn btn-sm btn-link p-0 text-decoration-none">
                                        <span>View Returning Guests</span> <i class="fa fa-arrow-right ms-1"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ===================================================== -->
                    <!-- SECTION 2: DATE-RANGE VISITOR KPIs                     -->
                    <!-- ===================================================== -->
                    <div class="mb-2 mt-1">
                        <h5 class="fw-bold text-dark border-bottom pb-2">
                            <i class="text-primary me-2"></i> Visitor Activity, Selected Period
                        </h5>
                    </div>
                    <div class="row g-3 mb-4">

                        <!-- Total Visits in Range -->
                        <div class="col-12 col-sm-6 col-lg-4">
                            <div class="card shadow-sm border-0 rounded-3 p-3 h-100 bg-light">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <span class="text-muted small fw-semibold text-uppercase">Total Visits in Period</span>
                                        <h2 class="display-6 fw-bold text-dark mt-1 mb-0">
                                            <field name="visits_in_range"/>
                                        </h2>
                                        <small class="text-muted">All check-ins in selected range</small>
                                    </div>
                                    <div class="p-2 bg-secondary-subtle text-secondary rounded-3">
                                        <i class="fa fa-calendar fs-4"></i>
                                    </div>
                                </div>
                                <div class="mt-3 pt-2 border-top">
                                    <button name="action_open_reporting" type="object" class="btn btn-sm btn-link p-0 text-decoration-none">
                                        <span>Visits Analysis</span> <i class="fa fa-arrow-right ms-1"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- New Visitors in Range -->
                        <div class="col-12 col-sm-6 col-lg-4">
                            <div class="card shadow-sm border-0 rounded-3 p-3 h-100 bg-light">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <span class="text-muted small fw-semibold text-uppercase">New Visitors in Period</span>
                                        <h2 class="display-6 fw-bold text-primary mt-1 mb-0">
                                            <field name="new_visitors_in_range"/>
                                        </h2>
                                        <small class="text-muted">First-time visits in period</small>
                                    </div>
                                    <div class="p-2 bg-primary-subtle text-primary rounded-3">
                                        <i class="fa fa-user-plus fs-4"></i>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Returning Visitors in Range -->
                        <div class="col-12 col-sm-6 col-lg-4">
                            <div class="card shadow-sm border-0 rounded-3 p-3 h-100 bg-light">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <span class="text-muted small fw-semibold text-uppercase">Returning Visitors in Period</span>
                                        <h2 class="display-6 fw-bold text-warning mt-1 mb-0">
                                            <field name="returning_visitors_in_range"/>
                                        </h2>
                                        <small class="text-muted">Repeat visits in period</small>
                                    </div>
                                    <div class="p-2 bg-warning-subtle text-warning rounded-3">
                                        <i class="fa fa-history fs-4"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ===================================================== -->
                    <!-- SECTION 3: SEATING & BOOKING OPERATIONAL STATUS        -->
                    <!-- ===================================================== -->
                    <div class="mb-2 mt-1">
                        <h5 class="fw-bold text-dark border-bottom pb-2">
                            <i class="text-danger me-2"></i>Seating Availability
                        </h5>
                    </div>
                    <div class="row g-3 mb-4">

                        <!-- Total Configured Units -->
                        <div class="col-6 col-sm-4 col-lg-2">
                            <div class="card shadow-sm border-0 rounded-3 p-3 text-center h-100 bg-white">
                                <div class="p-2 rounded-circle bg-secondary-subtle mx-auto mb-2" style="width:48px;height:48px;line-height:32px;">
                                    <i class="fa fa-th-large text-secondary fs-5"></i>
                                </div>
                                <h3 class="fw-bold text-dark mb-0">
                                    <field name="total_seating_units"/>
                                </h3>
                                <small class="text-muted">Total Units</small>
                            </div>
                        </div>

                        <!-- Available Units -->
                        <div class="col-6 col-sm-4 col-lg-2">
                            <div class="card shadow-sm border-0 rounded-3 p-3 text-center h-100" style="background-color:#f0fdf4;">
                                <div class="p-2 rounded-circle bg-success-subtle mx-auto mb-2" style="width:48px;height:48px;line-height:32px;">
                                    <i class="fa fa-check-circle text-success fs-5"></i>
                                </div>
                                <h3 class="fw-bold text-success mb-0">
                                    <field name="available_units"/>
                                </h3>
                                <small class="text-muted">Available</small>
                            </div>
                        </div>

                        <!-- Reserved Units -->
                        <div class="col-6 col-sm-4 col-lg-2">
                            <div class="card shadow-sm border-0 rounded-3 p-3 text-center h-100" style="background-color:#fff7ed;">
                                <div class="p-2 rounded-circle bg-warning-subtle mx-auto mb-2" style="width:48px;height:48px;line-height:32px;">
                                    <i class="fa fa-lock text-warning fs-5"></i>
                                </div>
                                <h3 class="fw-bold text-warning mb-0">
                                    <field name="reserved_units"/>
                                </h3>
                                <small class="text-muted">Reserved</small>
                            </div>
                        </div>

                        <!-- Active Bookings -->
                        <div class="col-6 col-sm-4 col-lg-3">
                            <div class="card shadow-sm border-0 rounded-3 p-3 text-center h-100" style="background-color:#eff6ff;">
                                <div class="p-2 rounded-circle bg-primary-subtle mx-auto mb-2" style="width:48px;height:48px;line-height:32px;">
                                    <i class="fa fa-bookmark text-primary fs-5"></i>
                                </div>
                                <h3 class="fw-bold text-primary mb-0">
                                    <field name="active_bookings"/>
                                </h3>
                                <small class="text-muted">Active Bookings</small>
                                <div class="mt-2">
                                    <button name="action_view_reserved_bookings" type="object" class="btn btn-sm btn-link p-0 text-decoration-none" style="font-size:0.75rem;">
                                        View <i class="fa fa-arrow-right"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Guests in Active Bookings -->
                        <div class="col-6 col-sm-4 col-lg-3">
                            <div class="card shadow-sm border-0 rounded-3 p-3 text-center h-100" style="background-color:#faf5ff;">
                                <div class="p-2 rounded-circle bg-info-subtle mx-auto mb-2" style="width:48px;height:48px;line-height:32px;">
                                    <i class="fa fa-users text-info fs-5"></i>
                                </div>
                                <h3 class="fw-bold mb-0" style="color:#7c3aed;">
                                    <field name="active_booking_guests"/>
                                </h3>
                                <small class="text-muted">Guests on Premises</small>
                                <div class="mt-2">
                                    <button name="action_view_seating_management" type="object" class="btn btn-sm btn-link p-0 text-decoration-none" style="font-size:0.75rem;">
                                        Seating Map <i class="fa fa-arrow-right"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ===================================================== -->
                    <!-- SECTION 4: FINANCIAL KPIs MANAGER ONLY               -->
                    <!-- ===================================================== -->
                    <div groups="sunnyside_visitor_management.group_sunnyside_manager">
                        <div class="mb-2 mt-1">
                            <h5 class="fw-bold text-dark border-bottom pb-2">
                                <i class="text-success me-2"></i> Financial Performance
                            </h5>
                        </div>

                        <!-- Financial Value Cards -->
                        <div class="row g-3 mb-3">

                            <!-- Contracted Booking Value -->
                            <div class="col-12 col-sm-6 col-lg-4">
                                <div class="card shadow-sm border-0 rounded-3 p-3 h-100" style="border-left: 4px solid #059669 !important;">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="flex-grow-1">
                                            <span class="text-muted small fw-semibold text-uppercase">Contracted Booking Value</span>
                                            <h3 class="fw-bold text-success mt-1 mb-0">
                                                <field name="contracted_booking_value" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                            </h3>
                                            <small class="text-muted">Sum of booking totals (reservation date basis)</small>
                                        </div>
                                        <div class="p-2 bg-success-subtle text-success rounded-3 ms-2">
                                            <i class="fa fa-file-text-o fs-4"></i>
                                        </div>
                                    </div>
                                    <div class="mt-3 pt-2 border-top">
                                        <button name="action_view_booking_reporting" type="object" class="btn btn-sm btn-link p-0 text-decoration-none">
                                            <span>Booking Analytics</span> <i class="fa fa-arrow-right ms-1"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Recorded Collections -->
                            <div class="col-12 col-sm-6 col-lg-4">
                                <div class="card shadow-sm border-0 rounded-3 p-3 h-100" style="border-left: 4px solid #0ea5e9 !important;">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="flex-grow-1">
                                            <span class="text-muted small fw-semibold text-uppercase">Recorded Collections</span>
                                            <h3 class="fw-bold text-primary mt-1 mb-0">
                                                <field name="recorded_collections" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                            </h3>
                                            <small class="text-muted">Actual payments received in period</small>
                                        </div>
                                        <div class="p-2 bg-primary-subtle text-primary rounded-3 ms-2">
                                            <i class="fa fa-credit-card fs-4"></i>
                                        </div>
                                    </div>
                                    <div class="mt-3 pt-2 border-top">
                                        <button name="action_view_payment_reporting" type="object" class="btn btn-sm btn-link p-0 text-decoration-none">
                                            <span>Collections Analysis</span> <i class="fa fa-arrow-right ms-1"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Outstanding Balances -->
                            <div class="col-12 col-sm-6 col-lg-4">
                                <div class="card shadow-sm border-0 rounded-3 p-3 h-100" style="border-left: 4px solid #ef4444 !important;">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="flex-grow-1">
                                            <span class="text-muted small fw-semibold text-uppercase">Outstanding Balances</span>
                                            <h3 class="fw-bold text-danger mt-1 mb-0">
                                                <field name="outstanding_balances" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                            </h3>
                                            <small class="text-muted">Total amount due (all bookings, all time)</small>
                                        </div>
                                        <div class="p-2 bg-danger-subtle text-danger rounded-3 ms-2">
                                            <i class="fa fa-exclamation-triangle fs-4"></i>
                                        </div>
                                    </div>
                                    <div class="mt-3 pt-2 border-top">
                                        <button name="action_view_receivables" type="object" class="btn btn-sm btn-link p-0 text-decoration-none">
                                            <span>Outstanding Balances Report</span> <i class="fa fa-arrow-right ms-1"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Payment Status Breakdown -->
                        <div class="card border-0 rounded-3 p-3 bg-white shadow-sm mb-4">
                            <h6 class="fw-bold text-dark mb-3">
                                <i class="text-primary me-2"></i> Payment Status Breakdown
                            </h6>
                            <div class="row g-3">
                                <div class="col-12 col-sm-4">
                                    <div class="d-flex align-items-center gap-3 p-3 rounded-3" style="background-color:#fef2f2;">
                                        <div class="p-2 bg-danger-subtle rounded-3">
                                            <i class="fa fa-times-circle text-danger fs-5"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-danger fs-4">
                                                <field name="bookings_unpaid_count"/>
                                            </div>
                                            <div class="text-muted small">Unpaid Bookings</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-4">
                                    <div class="d-flex align-items-center gap-3 p-3 rounded-3" style="background-color:#fffbeb;">
                                        <div class="p-2 bg-warning-subtle rounded-3">
                                            <i class="fa fa-clock-o text-warning fs-5"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-warning fs-4">
                                                <field name="bookings_partial_count"/>
                                            </div>
                                            <div class="text-muted small">Partially Paid</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-4">
                                    <div class="d-flex align-items-center gap-3 p-3 rounded-3" style="background-color:#f0fdf4;">
                                        <div class="p-2 bg-success-subtle rounded-3">
                                            <i class="fa fa-check-circle text-success fs-5"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-success fs-4">
                                                <field name="bookings_paid_count"/>
                                            </div>
                                            <div class="text-muted small">Fully Paid</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ===================================================== -->
                    <!-- SECTION 5: PERIOD SUMMARIES (This Week / This Month)   -->
                    <!-- ===================================================== -->
                    <div class="mb-2 mt-1">
                        <h5 class="fw-bold text-dark border-bottom pb-2">
                            <i class="text-secondary me-2"></i> Period Summaries
                        </h5>
                    </div>
                    <div class="row g-3 mb-4">
                        <div class="col-12 col-sm-6">
                            <div class="card shadow-sm border-0 rounded-3 p-3 h-100 bg-light">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <span class="text-muted small fw-semibold text-uppercase">Check-ins This Week</span>
                                        <h2 class="display-6 fw-bold text-dark mt-1 mb-0">
                                            <field name="checkins_this_week"/>
                                        </h2>
                                        <small class="text-muted">Recorded visits since Monday</small>
                                    </div>
                                    <div class="p-2 bg-secondary-subtle text-secondary rounded-3">
                                        <i class="fa fa-calendar fs-4"></i>
                                    </div>
                                </div>
                                <div class="mt-3 pt-2 border-top">
                                    <button name="action_view_this_week_checkins" type="object" class="btn btn-sm btn-link p-0 text-decoration-none">
                                        <span>View Week's Check-ins</span> <i class="fa fa-arrow-right ms-1"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="card shadow-sm border-0 rounded-3 p-3 h-100 bg-light">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <span class="text-muted small fw-semibold text-uppercase">Check-ins This Month</span>
                                        <h2 class="display-6 fw-bold text-dark mt-1 mb-0">
                                            <field name="checkins_this_month"/>
                                        </h2>
                                        <small class="text-muted">Recorded visits this calendar month</small>
                                    </div>
                                    <div class="p-2 bg-dark-subtle text-dark rounded-3">
                                        <i class="fa fa-bar-chart fs-4"></i>
                                    </div>
                                </div>
                                <div class="mt-3 pt-2 border-top">
                                    <button name="action_view_this_month_checkins" type="object" class="btn btn-sm btn-link p-0 text-decoration-none">
                                        <span>View Month's Check-ins</span> <i class="fa fa-arrow-right ms-1"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ===================================================== -->
                    <!-- SECTION 6: ANALYTICAL PERSPECTIVES & SHORTCUTS         -->
                    <!-- ===================================================== -->
                    <div class="card border-0 rounded-3 p-3 bg-white shadow-sm">
                        <h6 class="fw-bold text-black mb-3">
                            <i class="text-primary me-2"></i> Analytical Perspectives &amp; Shortcuts
                        </h6>
                        <div class="d-flex flex-wrap gap-2">
                            <button name="action_open_reporting" type="object" class="btn btn-outline-primary btn-sm">
                                <i class="fa fa-line-chart me-1"></i> Visits Analysis
                            </button>
                            <button name="action_view_booking_reporting" type="object" class="btn btn-outline-secondary btn-sm">
                                <i class="fa fa-bookmark me-1"></i> Booking Analytics
                            </button>
                            <button name="action_view_payment_reporting" type="object" class="btn btn-outline-success btn-sm"
                                    groups="sunnyside_visitor_management.group_sunnyside_manager">
                                <i class="fa fa-credit-card me-1"></i> Collections Report
                            </button>
                            <button name="action_view_receivables" type="object" class="btn btn-outline-danger btn-sm"
                                    groups="sunnyside_visitor_management.group_sunnyside_manager">
                                <i class="fa fa-exclamation-triangle me-1"></i> Outstanding Balances
                            </button>
                            <button name="action_view_visitors" type="object" class="btn btn-outline-secondary btn-sm">
                                <i class="fa fa-users me-1"></i> Visitor Profiles
                            </button>
                            <button name="action_open_checkin_wizard" type="object" class="btn btn-outline-success btn-sm">
                                <i class="fa fa-id-card-o me-1"></i> Front-Desk Check-in
                            </button>
                            <button name="action_view_seating_management" type="object" class="btn btn-outline-info btn-sm">
                                <i class="fa fa-map-marker me-1"></i> Seating Map
                            </button>
                        </div>
                    </div>

                    <!-- Hidden currency field for monetary widget support -->
                    <field name="currency_id" invisible="1"/>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Management Dashboard Window Action -->
    <record id="action_sunnyside_dashboard" model="ir.actions.server">
        <field name="name">Dashboard</field>
        <field name="model_id" ref="model_sunnyside_dashboard"/>
        <field name="state">code</field>
        <field name="code">
action = model.action_open_dashboard()
        </field>
    </record>
</odoo>
