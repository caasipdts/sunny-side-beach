[odoo]
url = http://127.0.0.1:8069
database = odoo
username = sync-worker
password = REPLACE_WITH_SYNC_USER_PASSWORD

[cloud]
url = https://your-cloud-domain.example
device_id = reception-laptop
token_file = C:\ProgramData\SunnysideSync\sync_device_token
verify_tls = true
ca_file =

[worker]
online_interval = 15
retry_min = 5
retry_max = 60
reconcile_interval = 3600
; Maximum polling delay (seconds) during idle periods.
; The worker backs off from online_interval up to this cap when no data is moving.
max_idle_interval = 300
; How often (seconds) the worker auto-vacuums acknowledged outbox events and chunks.
; Set to 0 to disable auto-vacuum (the server-side cron still runs daily).
vacuum_interval = 86400
