<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sunnyside_sync.Status">
        <div class="o_nav_entry">
            <span class="badge rounded-pill"
                  t-att-class="{
                      'text-bg-success': status.state === 'online',
                      'text-bg-warning': status.state === 'degraded',
                      'text-bg-danger': status.state === 'offline',
                      'text-bg-secondary': status.state === 'unknown'
                  }"
                  t-att-title="title"
                  role="status"
                  aria-live="polite">
                <i class="fa fa-cloud me-1"/>
                <t t-esc="label"/>
            </span>
        </div>
    </t>
</templates>
