<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sunnyside_sync" model="ir.module.category">
        <field name="name">Sunnyside Synchronization</field>
        <field name="sequence">35</field>
    </record>

    <record id="res_groups_privilege_sunnyside_sync" model="res.groups.privilege">
        <field name="name">Sunnyside Synchronization</field>
        <field name="sequence">35</field>
        <field name="category_id" ref="module_category_sunnyside_sync"/>
    </record>

    <record id="group_sunnyside_sync_user" model="res.groups">
        <field name="name">Sunnyside Sync User</field>
        <field name="privilege_id" ref="res_groups_privilege_sunnyside_sync"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sunnyside_sync_manager" model="res.groups">
        <field name="name">Sunnyside Sync Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_sunnyside_sync"/>
        <field name="implied_ids" eval="[(4, ref('group_sunnyside_sync_user')), (4, ref('base.group_system'))]"/>
    </record>
</odoo>
